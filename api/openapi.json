            ],
            "format": "uuid"
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "kind": {
            "const": "duration",
            "type": "string"
          },
          "original_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
