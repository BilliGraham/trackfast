          "422": {
            "$ref": "#/components/responses/Error422"
          },
          "201": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryResponse"
                },
                "example": {
                  "entry_id": "00000000-0000-4000-8000-000000000001",
                  "kind": "timed",
                  "entry_date": "2026-10-26",
                  "project_id": "00000000-0000-4000-8000-000000000002",
                  "description": "Development",
                  "started_at": "2026-10-26T09:03:00+02:00",
                  "stopped_at": "2026-10-26T09:16:00+02:00",
                  "person_id": "00000000-0000-4000-8000-000000000003",
                  "version": 1,
                  "original_seconds": 780,
                  "effective_seconds": 900,
                  "rounding_interval_minutes": 5,
                  "export_state": "not_exported",
                  "updated_at": "2026-10-26T07:16:01Z"
