            "headers": {
              "ETag": {
                "schema": {
                  "type": "string",
                  "pattern": "^\"[1-9][0-9]*\"$"
                },
                "description": "Quoted current version."
              },
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "The created entry resource path."
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
